# ══════════════════════════════════════════════════════════════════════════════
# Masud Alimi Platform — environment template
#
# Copy to .env and fill in. NEVER commit .env, and never put real credentials
# in this file. See SECURITY.md before deploying.
# ══════════════════════════════════════════════════════════════════════════════

APP_NAME="মাসউদ আলিমী"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Official examination scheduling depends on this. Do not change.
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────────────────────
# cPanel MySQL is the system of record. utf8mb4 is required for Bengali/Arabic.
# NOTE: the legacy quiz-api.php credentials are compromised (SECURITY.md L1).
# Rotate them in cPanel and use the NEW values here — never the old pair.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=masudalimi
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# ─── Mail (cPanel SMTP) ───────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Compatibility input: tls uses smtp/STARTTLS; ssl uses smtps.
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ─── Ask Ustaz ────────────────────────────────────────────────────────────────
# Recipient for the Ask Ustaz form. Questions are EMAILED ONLY and are never
# written to the database or the application log (PROJECT_PLAN.md §6).
USTAZ_EMAIL=

# Google Sheets, if retained, are private authoring/export sources only. The runtime
# has no Sheet ID or direct Sheet-fetch configuration.
VITE_APP_NAME="${APP_NAME}"
